{% import 'auth/profile/_macros.html.twig' as macros %}
{% trans_default_domain 'auth+intl-icu' %}

<div class="card mb-3">
    <div class="card-header">{{ 'Your data'|trans }}</div>
    <div class="card-body">
        {{ macros.fields(fields|merge(providerFields)) }}
        {% if accountUrl %}
            <p class="mt-3 mb-0">
                <a href="{{ accountUrl }}" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">{{ 'Edit your data'|trans }}</a>
            </p>
        {% endif %}
    </div>
</div>

{% if otherDetails %}
    <details class="mb-3">
        <summary class="mb-2">{{ 'All the data of the provider'|trans }}</summary>
        <table class="table table-sm align-middle mb-0">
            <tbody>
                {% for name, value in otherDetails %}
                    <tr>
                        <th scope="row" class="w-25"><code>{{ name }}</code></th>
                        <td>{{ macros.value(value) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </details>
{% endif %}
