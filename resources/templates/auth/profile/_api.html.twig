{% trans_default_domain 'auth+intl-icu' %}

{#
    How to use the API: what the provider says (`Basic` or `Bearer`), its tokens if
    it has them and where its documentation is. Each part is a partial, so a site
    that has another path or another documentation overrides only that one.
#}
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">{{ 'How to use the API'|trans }}</div>
            <div class="card-body">
                {% include 'auth/profile/_api-' ~ (apiScheme|lower) ~ '.html.twig' %}
                {% include 'auth/profile/_api-docs.html.twig' %}
            </div>
        </div>
    </div>
    {% if tokensSupported %}
        <div class="col-lg-6">
            {% include 'auth/profile/_tokens.html.twig' %}
        </div>
    {% endif %}
</div>
