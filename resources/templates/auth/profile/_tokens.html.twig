{% trans_default_domain 'auth+intl-icu' %}

{#
    The tokens of the user, in a card of all the width. The duration is what a token
    lasts from when it was made, and the remaining is what is left of it from now.
#}
{% set now = 'now'|date('U') + 0 %}
<div class="card mb-3" id="api_tokens-card">
    <div class="card-header">{{ 'Tokens of the API'|trans }}</div>
    <div class="card-body">
        {% if tokensError %}
            <div class="alert alert-warning small" role="alert">{{ tokensError|trans }}</div>
        {% endif %}

        {% if tokens %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Created'|trans }}</th>
                            <th scope="col">{{ 'Last used'|trans }}</th>
                            <th scope="col">{{ 'Expires'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Duration'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Remaining'|trans }}</th>
                            <th scope="col">{{ 'Browser'|trans }}</th>
                            <th scope="col"><span class="visually-hidden">{{ 'Revoke'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for token in tokens %}
                            <tr>
                                <td class="text-nowrap">{{ token.createdAt|date('Y-m-d H:i') }}</td>
                                <td class="text-nowrap">{{ token.lastUsedAt|date('Y-m-d H:i') }}</td>
                                <td class="text-nowrap">{{ token.expiresAt|date('Y-m-d') }}</td>
                                <td class="text-end text-nowrap">{{ '{days, plural, one {# day} other {# days}}'|trans({'days': ((token.expiresAt - token.createdAt) / 86400)|round}) }}</td>
                                <td class="text-end text-nowrap">
                                    {% if token.expiresAt <= now %}
                                        <span class="badge text-bg-danger">{{ 'Expired'|trans }}</span>
                                    {% else %}
                                        {{ '{days, plural, one {# day} other {# days}}'|trans({'days': ((token.expiresAt - now) / 86400)|round(0, 'ceil')}) }}
                                    {% endif %}
                                </td>
                                <td class="small">{{ token.browser ?? '—' }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('auth_token_revoke', {'id': token.id}) }}" onsubmit="return confirm('{{ 'The token will stop working at once. Revoke it?'|trans|e('js') }}');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'Revoke'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% elseif not tokensError %}
            <p class="text-body-secondary mb-0">{{ 'You have no tokens yet.'|trans }}</p>
        {% endif %}
    </div>
</div>
