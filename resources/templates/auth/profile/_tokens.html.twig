{% trans_default_domain 'auth+intl-icu' %}

<div class="card h-100">
    <div class="card-header">{{ 'Tokens of the API'|trans }}</div>
    <div class="card-body">
        {% if tokensError %}
            <div class="alert alert-warning small" role="alert">{{ tokensError|trans }}</div>
        {% endif %}

        {% if tokens %}
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Created'|trans }}</th>
                            <th scope="col">{{ 'Last used'|trans }}</th>
                            <th scope="col">{{ 'Expires'|trans }}</th>
                            <th scope="col">{{ 'Address'|trans }}</th>
                            <th scope="col">{{ 'Browser'|trans }}</th>
                            <th scope="col"><span class="visually-hidden">{{ 'Revoke'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for token in tokens %}
                            <tr>
                                <td>{{ token.createdAt|date('Y-m-d H:i') }}</td>
                                <td>{{ token.lastUsedAt|date('Y-m-d H:i') }}</td>
                                <td>{{ token.expiresAt|date('Y-m-d') }}</td>
                                <td>{{ token.ip ?? '—' }}</td>
                                <td class="small">{{ token.browser ?? '—' }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('auth_token_revoke', {'id': token.id}) }}" onsubmit="return confirm('{{ 'The token will stop working at once. Revoke it?'|trans|e('js') }}');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'Revoke'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% elseif not tokensError %}
            <p class="text-body-secondary">{{ 'You have no tokens yet.'|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('auth_token_create') }}">
            {% for field in tokenFields %}
                <div class="mb-3">
                    <label for="token-{{ field.name }}" class="form-label">{{ field.label|trans }}</label>
                    <input type="{{ field.type }}" class="form-control" id="token-{{ field.name }}" name="{{ field.name }}"{{ field.required ? ' required' : '' }} autocomplete="{{ field.type == 'password' ? 'current-password' : 'off' }}">
                </div>
            {% endfor %}
            <button type="submit" class="btn btn-primary btn-sm">{{ 'Generate a token'|trans }}</button>
        </form>
        <p class="form-text mt-2 mb-0">{{ 'Treat the token as a password: whoever has it acts as you. You can have as many as you need and revoke each one by itself.'|trans }}</p>
    </div>
</div>
