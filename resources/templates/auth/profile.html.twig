{% extends 'layouts/default.html.twig' %}
{% trans_default_domain 'auth+intl-icu' %}

{#
    The profile of the user: the same page for every provider, in tabs.

    A site that needs more tabs overrides the partials
    `auth/profile/_tabs-extra.html.twig` and `auth/profile/_panes-extra.html.twig`.
    One that uses the API in another way (its path, its documentation) overrides
    `auth/profile/_api-basic.html.twig`, `auth/profile/_api-bearer.html.twig` or
    `auth/profile/_api-docs.html.twig`.
#}

{% block content %}
<div class="my-5 container">
    <h1 class="border-bottom mb-4">{% block title %}{{ 'Profile'|trans }}{% endblock %}</h1>
    {% include 'partials/flash-messages.html.twig' %}

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link{{ activeTab == 'data' ? ' active' : '' }}" id="data-tab" data-bs-toggle="tab" href="#data" role="tab" aria-controls="data" aria-selected="{{ activeTab == 'data' ? 'true' : 'false' }}">{{ 'Data'|trans }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link{{ activeTab == 'api' ? ' active' : '' }}" id="api-tab" data-bs-toggle="tab" href="#api" role="tab" aria-controls="api" aria-selected="{{ activeTab == 'api' ? 'true' : 'false' }}">{{ 'API'|trans }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link{{ activeTab == 'session' ? ' active' : '' }}" id="session-tab" data-bs-toggle="tab" href="#session" role="tab" aria-controls="session" aria-selected="{{ activeTab == 'session' ? 'true' : 'false' }}">{{ 'Session'|trans }}</a>
        </li>
        {% include 'auth/profile/_tabs-extra.html.twig' %}
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade{{ activeTab == 'data' ? ' show active' : '' }}" id="data" role="tabpanel" aria-labelledby="data-tab">
            {% include 'auth/profile/_data.html.twig' %}
        </div>
        <div class="tab-pane fade{{ activeTab == 'api' ? ' show active' : '' }}" id="api" role="tabpanel" aria-labelledby="api-tab">
            {% include 'auth/profile/_api.html.twig' %}
        </div>
        <div class="tab-pane fade{{ activeTab == 'session' ? ' show active' : '' }}" id="session" role="tabpanel" aria-labelledby="session-tab">
            {% include 'auth/profile/_session.html.twig' %}
        </div>
        {% include 'auth/profile/_panes-extra.html.twig' %}
    </div>
</div>
{% endblock %}
