{% extends 'layouts/default.html.twig' %}
{% trans_default_domain 'auth+intl-icu' %}

{% block content %}
<div class="my-5 container">
    <h1 class="border-bottom mb-4">{% block title %}{{ 'Login'|trans }}{% endblock %}</h1>
    {% include 'partials/flash-messages.html.twig' %}
    {{ form_start(form, {'attr': {'action': path('auth_login')}}) }}
        {{ form_element(form.uiSchema, form) }}
        {{ form_captcha(form) }}
        {{ form_csrf(form) }}
        <button type="submit" class="btn btn-primary w-100">{{ 'Login'|trans }}</button>
    {{ form_end(form) }}
</div>
{% endblock %}
