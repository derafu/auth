{
  "realm": "test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "revokeRefreshToken": false,
  "offlineSessionIdleTimeout": 315360000,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "editor"
      }
    ],
    "client": {
      "derafu-auth": [
        {
          "name": "app-editor"
        }
      ],
      "derafu-api": [
        {
          "name": "reader"
        },
        {
          "name": "writer"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "derafu-auth",
      "name": "Derafu Auth tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://app.test/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "https://app.test/bye",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "derafu-api",
      "name": "The API that the tests protect",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "derafu-service",
      "name": "A service that calls the API (client credentials)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "derafu-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "derafu-cli",
      "name": "A program of a person that calls the API (password grant)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "derafu-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "derafu-noaudience",
      "name": "A service whose tokens are not for the API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "noaudience-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "ana",
      "email": "ana@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Perez",
      "credentials": [
        {
          "type": "password",
          "value": "secret",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ],
      "clientRoles": {
        "derafu-auth": [
          "app-editor"
        ],
        "account": [
          "view-profile"
        ],
        "derafu-api": [
          "writer"
        ]
      }
    },
    {
      "username": "otto",
      "email": "otto@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Otto",
      "lastName": "Rojas",
      "credentials": [
        {
          "type": "password",
          "value": "secret",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "offline_access"
      ],
      "clientRoles": {
        "account": [
          "view-profile",
          "manage-account"
        ],
        "derafu-api": [
          "writer"
        ]
      }
    },
    {
      "username": "service-account-derafu-service",
      "enabled": true,
      "serviceAccountClientId": "derafu-service",
      "realmRoles": [
        "editor"
      ],
      "clientRoles": {
        "derafu-api": [
          "reader"
        ]
      }
    },
    {
      "username": "service-account-derafu-noaudience",
      "enabled": true,
      "serviceAccountClientId": "derafu-noaudience",
      "realmRoles": [
        "editor"
      ]
    }
  ]
}
